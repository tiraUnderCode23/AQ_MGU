{
  "schema": 1,
  "tools": [
    {
      "id": "idrive7-renderd",
      "path": "kit/renderd/prebuilt",
      "title": "GPU renderer",
      "description": "The apps' own GPU renderer (mgu-render): draws them at 60 fps, beside the MGU Store's Renderer; installed with the apps (iDrive 7 and iDrive 8)",
      "mguHmi": [
        "ID7",
        "ID8"
      ]
    },
    {
      "id": "mgu-inputgate",
      "path": "kit/renderd/inputgate/tool",
      "title": "Controller gate",
      "description": "Lets the apps have the iDrive controller (tabs, page buttons, settings, Doom); loads into the HMI at the next start (iDrive 7 and iDrive 8)",
      "needs": [
        "renderer"
      ],
      "optional": false,
      "uninstallable": true,
      "mguHmi": [
        "ID7",
        "ID8"
      ]
    }
  ],
  "components": [
    {
      "id": "andrei_mdrive",
      "kind": "app",
      "path": "apps/andrei_mdrive",
      "manifest": "app.json",
      "title": "M Drive",
      "version": "0.4.0",
      "mguHmi": [
        "ID7",
        "ID8"
      ],
      "requires": {
        "idrive7-renderd": "2.1.18",
        "mgu-inputgate": "1.1.0"
      },
      "build": {
        "python": "kit/tools/build.py",
        "args": [
          "{id}"
        ],
        "sdk": "oap-sdk",
        "output": "dist/{id}@{version}.tgz",
        "shared": [
          "kit/runtime",
          "kit/platform",
          "kit/localization",
          "kit/tools/build.py",
          "kit/tools/pack_data.py",
          "kit/tools/localize.py",
          "kit/tools/locale-revisions.json",
          "kit/tools/oapgen",
          "oap-sdk",
          "kit/tools/make_icon.js"
        ]
      },
      "icon": "icon.png",
      "description": "Motorsport dashboard with RPM, five gauges, MHD map acknowledgement, exhaust flaps and max cooling."
    }
  ]
}

{
 "id": "pps_warmup",
 "title": "Proven Warm-Up",
 "description": "BETA, not yet tested on a car. Shows when engine oil, gearbox oil and coolant reach the warm-up temperatures set by Proven Performance Solutions. A guide only: it does not replace the car's own warnings",
 "version": "1.2.1",
 "vendor": "Proven Performance Solutions",
 "loggingId": "PPW1",
 "iconGlyph": "temp",
 "autostart": true,
 "mguHmi": [
  "ID7",
  "ID8"
 ],
 "requires": {
  "idrive7-renderd": "2.1.15"
 },
 "signals": {
  "de.bmw.infotainment.vehicle.CDS": {
   "statusEngineSpeed2": "rs",
   "statusEngineTemperature": "rs"
  },
  "de.bmw.infotainment.vehicle.Vehicle2": {
   "statusCarSpeed2": "rs"
  },
  "de.bmw.infrastructure.analytics.BasicDataSet": {
   "_optional": "gearbox oil temperature (when the gearbox unit has none)",
   "basicDataSet": "s"
  },
  "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
   "_instances": "SystemFunctionsInternalTasuInst1",
   "_methods": [
    "sendTasuRequest"
   ],
   "_broadcasts": [
    "sendTasuResponse"
   ]
  }
 },
 "screens": [
  {
   "name": "MAIN",
   "kind": "canvas",
   "title": "Proven Warm-Up",
   "buttons": [
    [
     "BTN_SETTINGS",
     "Settings"
    ]
   ]
  }
 ],

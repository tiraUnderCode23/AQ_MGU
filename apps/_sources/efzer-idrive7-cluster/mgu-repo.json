{
  "schema": 1,
  "apps": {
    "path": "apps/*",
    "manifest": "app.json",
    "icon": "icon.png",
    "mguHmi": ["ID7"],
    "requires": { "mgu-render": "0.6.0" },
    "build": {
      "python": "kit/tools/build.py",
      "args": ["{id}", "--language", "ru"],
      "sdk": "oap-sdk",
      "output": "dist/{id}@{version}-ru.1.tgz"
    }
  }
}

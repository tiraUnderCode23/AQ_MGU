{
  "schema": 1,
  "components": [
    {
      "id": "true_time",
      "kind": "app",
      "path": "true-time/app",
      "title": "True Time",
      "description": "Acceleration and braking times, measured and corrected for the road's slope",
      "mguHmi": [
        "ID7"
      ],
      "icon": "icon.png",
      "build": {
        "python": "tools/build_unit.py",
        "args": [
          "{id}",
          "{dir}"
        ],
        "sdk": "vendor/idrive7-apps/oap-sdk",
        "shared": [
          "vendor/idrive7-apps"
        ],
        "output": "vendor/idrive7-apps/dist/{id}@{version}.tgz"
      }
    },
    {
      "id": "boostline",

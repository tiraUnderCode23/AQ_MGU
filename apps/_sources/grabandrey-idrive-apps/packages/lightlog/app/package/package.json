{
  "name": "ida_lightlog",
  "version": "1.3.1",
  "description": "Logs the interior light modules (seat logos included), the engine and the speed, read-only",
  "private": false,
  "main": "javascript/runner.js",
  "oapAppSettings": {
    "maxDiskUsage": 5242880,
    "cpuLimit": 20,
    "memoryThresholdKB": 65536,
    "priority": "PRIO_MEDIUM",
    "visibility": "FOREGROUND",
    "latencyClass": "FOREGROUND",
    "loggingId": "LTLG",
    "userLoginRequired": false,
    "backgroundPriority": 150,
    "someipManifest": "manifest.json"
  },
  "files": [
    "config",
    "rhmiData",
    "package.json",
    "npm-shrinkwrap.json",
    "permissions.json",
    "javascript",
    "manifest.json",
    "LICENSE"
  ],
  "dependencies": {
    "oap-sdk": "24.10.2"
  },
  "engines": {
    "node": ">=8.7.0"
  },
  "author": "LightLog",
  "license": "MIT",
  "mguHmi": [
    "ID8"
  ],
  "mguAppStartType": "autostart"
}

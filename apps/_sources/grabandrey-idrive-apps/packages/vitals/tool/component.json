{
  "id": "ida-vitals-cluster",
  "kind": "tool",
  "version": "1.3.2",
  "title": "Vitals Cluster",
  "description": "iDrive 8-style widget for the middle of the cluster: water, engine oil and gearbox oil temperature bars, and each tyre's temperature and pressure. Pick 'Vitals' in the cluster's widget menu; the Vitals app feeds it the car's data and holds its settings. EXPERIMENTAL, untested on a car.",
  "optional": true,
  "uninstallable": true,
  "mguHmi": ["ID8"],
  "requires": {
    "cluster-render": "0.6.9",
    "mgu-deploy": "0.7.0"
  },
  "files": [
    { "path": "vitals.js", "from": "vitals.js", "mode": "0644" },
    { "path": "layout.js", "from": "layout.js", "mode": "0644" },
    { "path": "view.js", "from": "view.js", "mode": "0644" },
    { "path": "text.js", "from": "text.js", "mode": "0644" },
    { "path": "font.js", "from": "font.js", "mode": "0644" },
    { "path": "shader.js", "from": "shader.js", "mode": "0644" },
    { "path": "preview.png", "from": "preview.png", "mode": "0644" },
    { "path": "cluster-render.d/vitals.conf", "from": "cluster-render.d/vitals.conf", "mode": "0644" }
  ],
  "units": [
    { "name": "ida-vitals-cluster.service", "from": "ida-vitals-cluster.service" }
  ],
  "enable": [
    { "unit": "ida-vitals-cluster.service", "target": "multi-user.target" }
  ],
  "recmgr": ["ida-vitals-cluster"],
  "restart": ["ida-vitals-cluster.service"]
}

# (As amn-iptv.service, M850i-amn/idrive7-apps, from aurelmarius' TVH Player service.)
[Unit]
Description=clucraft-plex: a Plex account's films and series on the head unit, for the app Drive-In
RequiresMountsFor=/var/opt
# Started by the app's connection to the socket, never at boot; it ends 10 minutes after the app's last
# request while nothing plays. Ordered before no head-unit unit, waited for by none.
Requires=clucraft-plex.socket
After=clucraft-plex.socket
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
# root: the player's frame file is made owned by nobody (mgu-render takes that), and the account's token is kept
# readable by root only. The Plex client and the player (tvh-player) run as the tool's uid (13271) and as nobody,
# children of this service with its limits and LimitCORE.
# No "+" commands: every command here runs with the limits below, LimitCORE=1 included.
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
Environment=PLEXD_STATE=/var/opt/clucraft-plex/state
ExecStartPre=-/bin/sh -c 'mkdir -p /var/opt/clucraft-plex/state && chmod 0700 /var/opt/clucraft-plex/state'
ExecStart=/usr/bin/node /var/opt/clucraft-plex/current/service.js
# however the service ended (stop, crash, kill, the out-of-memory killer): no frame file left behind
ExecStopPost=-/usr/bin/node /var/opt/clucraft-plex/current/cleanup.js
Restart=on-failure
RestartSec=10
TimeoutStopSec=8
Nice=10
IOSchedulingClass=idle
# a film: 2 of the unit's 4 cores at most (the decoding is the GPU's; the picture's copy, the sound and the posters'
# scaling are ours); nice 10 keeps CarPlay and the HMI first.
CPUQuota=200%
# the GPU's decode surfaces are charged here too (shmem), beside the stream read ahead (24 MiB) and the player's
# queue (40 MiB at most): amn-iptv's limit, found in the car
MemoryLimit=768M
TasksMax=48
# No core dump goes to the crash handler (which restarts the head unit for a program it does not list),
# so a crash restarts this service and never the head unit.
LimitCORE=1
StandardOutput=journal
StandardError=journal

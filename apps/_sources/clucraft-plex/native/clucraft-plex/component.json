{
  "id": "clucraft-plex",
  "kind": "tool",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "title": "Drive-In service",
  "description": "For the app Drive-In: the films and series of your own Plex Media Server on the head unit. The server's stream (H.264 with AAC, as HLS) is decoded on the GPU into mgu-render's frame file (the app shows it) and played into SmartXbar's CarLife input. Sign in once with Plex's link code (plex.tv/link on your phone): no password is typed in the car, and the account's token is kept on this head unit only (root's, 0600), never in the app or its repository. Its internet goes through mgu-uplink, as uid 13271 only; the player runs as nobody. Built on amn-iptv's service and tvh-player (GPL-3.0-or-later).",
  "requires": {
    "mgu-deploy": "0.7.0",
    "mgu-uplink": "0.7.0"
  },
  "uninstallable": true,
  "mguHmi": ["ID7"],
  "internet": true,
  "uids": [13271],
  "files": [
    { "path": "service.js", "from": "service.js", "mode": "0644" },
    { "path": "client.js", "from": "client.js", "mode": "0644" },
    { "path": "plex.js", "from": "plex.js", "mode": "0644" },
    { "path": "session.js", "from": "session.js", "mode": "0644" },
    { "path": "hls.js", "from": "hls.js", "mode": "0644" },
    { "path": "art.js", "from": "art.js", "mode": "0644" },
    { "path": "jpeg_decoder.js", "from": "jpeg_decoder.js", "mode": "0644" },
    { "path": "netx.js", "from": "netx.js", "mode": "0644" },
    { "path": "player.js", "from": "player.js", "mode": "0644" },
    { "path": "sockgroup.js", "from": "sockgroup.js", "mode": "0644" },
    { "path": "check.js", "from": "check.js", "mode": "0644" },
    { "path": "cleanup.js", "from": "cleanup.js", "mode": "0644" },
    { "path": "cacert.pem", "from": "cacert.pem", "mode": "0644" },
    { "path": "tvh-player", "from": "tvh-player", "mode": "0755" },
    { "path": "FFMPEG-LICENSE", "from": "FFMPEG-LICENSE", "mode": "0644" },
    { "path": "LICENSE", "from": "LICENSE", "mode": "0644" },
    { "path": "LICENSE.jpeg-js", "from": "LICENSE.jpeg-js", "mode": "0644" },
    { "path": "README.md", "from": "README.md", "mode": "0644" }
  ],
  "check": ["check.js"],
  "deactivate": ["node", "cleanup.js"],
  "crashNames": ["tvh-player"],
  "units": [
    { "name": "clucraft-plex.socket", "from": "systemd/clucraft-plex.socket" },
    { "name": "clucraft-plex.service", "from": "systemd/clucraft-plex.service" }
  ],
  "enable": [
    { "unit": "clucraft-plex.socket", "target": "sockets.target" }
  ],
  "recmgr": ["clucraft-plex"],
  "restart": ["clucraft-plex.service"],
  "versionFiles": ["service.js"]
}

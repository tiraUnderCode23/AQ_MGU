{
  "id": "c365_drive",
  "title": "Drive",
  "description": "Speed, gear, oil and coolant, and the trip since you opened the app",
  "version": "1.9.3",
  "vendor": "custom",
  "loggingId": "C365",
  "iconGlyph": "gauge",
  "mguHmi": ["ID7", "ID8"],
  "signals": {
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "_optional": "the selected gear; without it the gear is estimated from speed and rpm",
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    },
    "de.bmw.infotainment.navigation.positioning.Positioning": {
      "_optional": "the car GPS, so a camera ahead in Warsaw can be warned about",
      "_instances": "Main_Instance",
      "position": "rs",
      "gnssPosition": "rs",
      "mapMatchedPosition": "rs"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Drive",
      "buttons": [
        ["BTN_ACTION", "Reset trip"],
        ["BTN_SETTINGS", "Settings"]
      ]
    }
  ],
  "settings": [
    {"key": "speedUnit", "label": "Speed unit", "type": "choice", "default": "kmh",
     "options": [["kmh", "km/h"], ["mph", "mph"]]},
    {"key": "octane", "label": "Octane", "type": "choice", "default": "98",
     "options": [["95", "95"], ["98", "98"], ["100", "100"], ["102", "102"]]},
    {"key": "theme", "label": "Colour theme", "type": "choice", "default": "m_tricolour",
     "options": [["m_red", "M Red"], ["m_tricolour", "M Tricolour"], ["ice", "Ice White"], ["amber", "Night Amber"]]},
    {"key": "layout", "label": "Screen layout", "type": "choice", "default": "full",
     "options": [["full", "Full screen"], ["standard", "Standard"]]},
    {"key": "renderer", "label": "Renderer", "type": "choice", "default": "auto",
     "options": [["auto", "GPU 60 fps (default)"], ["software", "Software"]]},
    {"key": "demo", "label": "Demo data", "type": "choice", "default": "auto",
     "options": [["auto", "Auto"], ["on", "Always"], ["off", "Never"]]},
    {"key": "projStyle", "label": "Projection", "type": "choice", "default": "arc",
     "options": [["arc", "Arc"], ["bar", "Bar"], ["ring", "Ring"], ["split", "Split"], ["lights", "Lights"], ["needle", "Needle"], ["stack", "Stack"], ["corner", "Corner"], ["tape", "Tape"], ["halo", "Halo"], ["steps", "Steps"], ["dual", "Dual"], ["horizon", "Horizon"], ["chevron", "Chevron"], ["orbit", "Orbit"]]},
    {"key": "projSize", "label": "Projection size", "type": "number", "default": 100, "unit": "%",
     "steps": [70, 85, 100, 115, 130, 150]},
    {"key": "projHeight", "label": "Projection height", "type": "number", "default": 0,
     "steps": [-80, -40, 0, 40, 80, 120],
     "labels": {"-80": "Low", "-40": "Lower", "0": "Middle", "40": "Higher", "80": "High", "120": "Top"}},
    {"key": "projFont", "label": "Projection font", "type": "choice", "default": "num",
     "options": [["num", "Numbers"], ["bold", "Bold"], ["light", "Light"], ["gear", "Gear"], ["gear_barlow", "Barlow"]]},
    {"key": "projAccent", "label": "Accent colour", "type": "choice", "default": "#9fd0ff",
     "options": [["#9fd0ff", "Ice"], ["#f4f7fb", "White"], ["#ff3b3b", "Red"], ["#ffb020", "Amber"], ["#3dd68c", "Green"], ["#3ee0ff", "Cyan"], ["#ff4fd8", "Magenta"], ["#ff7a18", "Orange"]]},
    {"key": "projText", "label": "Text colour", "type": "choice", "default": "#f4f7fb",
     "options": [["#f4f7fb", "White"], ["#9fd0ff", "Ice"], ["#ffb020", "Amber"], ["#3dd68c", "Green"], ["#3ee0ff", "Cyan"]]},
    {"key": "projRed", "label": "Redline colour", "type": "choice", "default": "#ff3b3b",
     "options": [["#ff3b3b", "Red"], ["#ff7a18", "Orange"], ["#ff4fd8", "Magenta"], ["#ffb020", "Amber"]]},
    {"key": "projRedline", "label": "Redline", "type": "number", "default": 7000, "unit": "rpm",
     "steps": [5500, 6000, 6500, 7000, 7500, 8000]},
    {"key": "projFlash", "label": "Flash at redline", "type": "bool", "default": true},
    {"key": "clusterStyle", "label": "Cluster", "type": "choice", "default": "off",
     "options": [["off", "Stock"], ["m2", "M2"], ["m3", "M3"], ["911", "911"], ["ferrari", "Ferrari"], ["fdial", "F Dial"], ["lambo", "Lambo"], ["amg", "AMG"], ["rs", "RS"], ["mclaren", "McLaren"], ["bugatti", "Bugatti"], ["gtr", "GT-R"], ["vette", "Vette"], ["typer", "Type R"], ["aston", "Aston"], ["lfa", "LFA"], ["pagani", "Pagani"], ["rimac", "Rimac"], ["fordgt", "Ford GT"], ["alpine", "Alpine"], ["bentley", "Bentley"], ["jesko", "Jesko"], ["m5x", "M5"], ["amgs", "AMG S"], ["bmwr", "Round"], ["m2x", "M2 D"], ["wing", "Wing"], ["split", "Split"], ["pods", "Pods"], ["night", "Night"], ["amgc", "AMG C"]]},
    {"key": "camAlert", "label": "Camera beep", "type": "bool", "default": true},
    {"key": "camTest", "label": "Camera test", "type": "choice", "default": "off",
     "options": [["off", "Off"], ["approach", "Drive toward a camera"]]}
  ]
}

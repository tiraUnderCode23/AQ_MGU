{
  "id": "ahg_control_center",
  "title": "AHG Control Center",
  "description": "After Hours Garage dashboard for ID7: live gauges, hybrid battery, drive logging, health check and stock MG1 exhaust flap control.",
  "version": "1.4.2",
  "vendor": "After Hours Garage",
  "license": "MIT",
  "loggingId": "AHG1",
  "iconGlyph": "AHG",
  "mguHmi": [
    "ID7"
  ],
  "memoryKB": 131072,
  "cpuLimit": 30,
  "signals": {
    "de.bmw.infotainment.vehicle.CDS": {
      "_optional": "RPM and engine temperatures unavailable",
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "_optional": "Speed unavailable",
      "statusCarSpeed2": "rs"
    },
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_optional": "Diagnostic reads (HV battery, 12 V) and vehicle controls unavailable",
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "_optional": "Driving-mode, boost, power and torque display unavailable",
      "statusFESVehicleDynamicSwitchHMI": "rs",
      "statusSwitchDriveDynamicSport2": "rs",
      "statusVehicleDynamicEngine": "rs",
      "statusActualValueTorque2": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle": {
      "_optional": "Pressure unit unknown (boost shown as bar)",
      "statusNewCurrentUnitsStatusExt": "rs"
    },
    "de.bmw.infotainment.drivingexcitement.Efficiencytainment2": {
      "_optional": "HV battery temperature and eDRIVE needle unavailable",
      "statusBatteryTemperature": "rs",
      "statusPowerRelativHybrid": "rs"
    },
    "de.bmw.infotainment.lsc.LSCDataSink": {
      "_optional": "HV voltage broadcast unavailable",
      "statusHighVoltageStorage": "s"
    },
    "de.bmw.infrastructure.analytics.BasicDataSet": {
      "_optional": "Gearbox oil broadcast unavailable",
      "basicDataSet": "s"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "AHG Control Center",
      "buttons": [
        [
          "BTN_PAGE",
          "Next page"
        ],
        [
          "BTN_PREV",
          "Previous page"
        ],
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    }
  ],
  "settings": [
    {
      "key": "controlMode",
      "label": "Control mode (desktop emulator is always simulation)",
      "type": "choice",
      "default": "vehicle",
      "options": [
        [
          "simulation",
          "Simulation \u2014 every control, no vehicle writes"
        ],
        [
          "vehicle",
          "Vehicle \u2014 stock MG1 exhaust flap"
        ]
      ],
      "hidden": true
    },
    {
      "key": "hold",
      "label": "Hold flap position",
      "type": "choice",
      "default": "on",
      "options": [
        [
          "on",
          "On - re-send Open/Closed every 15 s"
        ],
        [
          "off",
          "Off - the DME returns to auto after ~20 s"
        ]
      ],
      "reset": 2
    },
    {
      "key": "closeLimit",

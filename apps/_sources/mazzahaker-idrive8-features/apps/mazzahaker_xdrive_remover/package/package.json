{
  "name": "mazzahaker_xdrive_remover",
  "version": "0.1.26",
  "description": "Transfer case diagnostics for BMW iDrive 7 and 8, with an experimental front drive off command (until ignition cycle).",
  "private": false,
  "main": "javascript/runner.js",
  "oapAppSettings": {
    "maxDiskUsage": 26214400,
    "cpuLimit": 30,
    "memoryThresholdKB": 131072,
    "priority": "PRIO_MEDIUM",
    "visibility": "FOREGROUND",
    "latencyClass": "FOREGROUND",
    "loggingId": "XDRV",
    "userLoginRequired": false,
    "backgroundPriority": 150,
    "someipManifest": "manifest.json"
  },
  "files": [
    "config",
    "rhmiData",
    "package.json",
    "npm-shrinkwrap.json",
    "permissions.json",
    "javascript",
    "manifest.json",
    "CHANGELOG.md",
    "NOTICE",
    "LICENSE-Inter.txt"
  ],
  "dependencies": {
    "oap-sdk": "24.10.2"
  },
  "engines": {
    "node": ">=8.7.0"
  },
  "license": "GPL-3.0-or-later",
  "mguLocalOnly": true,
  "productName": "xDriveRemover",
  "author": "mazzahaker"
}

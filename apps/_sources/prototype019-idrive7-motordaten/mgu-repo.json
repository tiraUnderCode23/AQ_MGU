{
  "schema": 1,
  "apps": {
    "path": "apps/*",
    "manifest": "app.json",
    "icon": "icon.png",
    "mguHmi": ["ID7", "ID8"],
    "build": {
      "python": "kit/tools/build.py",
      "args": ["{id}"],
      "sdk": "oap-sdk",
      "output": "dist/{id}@{version}.tgz",
      "shared": ["kit/runtime", "kit/platform", "kit/localization", "kit/tools/build.py", "kit/tools/pack_data.py",
        "kit/tools/localize.py", "kit/tools/locale-revisions.json", "kit/tools/oapgen", "oap-sdk"]
    }
  },
  "tools": [
    {
      "id": "idrive7-renderd",
      "path": "kit/renderd/prebuilt",
      "title": "GPU renderer",
      "description": "Eigener GPU-Renderer der Apps (mgu-render): zeichnet sie mit 60 fps; wird mit den Apps installiert (iDrive 7 und 8).",
      "mguHmi": ["ID7", "ID8"]
    },
    {
      "id": "mgu-inputgate",
      "path": "kit/renderd/inputgate/tool",
      "title": "Controller gate",
      "description": "Gibt den Apps den iDrive-Controller (Tabs, Seitentasten, Einstellungen); laedt beim naechsten Start in die HMI (iDrive 7 und 8).",
      "needs": ["renderer"],
      "optional": false,
      "uninstallable": true,
      "mguHmi": ["ID7", "ID8"]
    }
  ]
}

[Unit]
Description=Esagono: supercar-style hexagon rev ring in the iDrive 8 cluster's middle (drawn by cluster-render)
After=cluster-render.socket vsomeipd.service

[Service]
# root: the SOME/IP rpm helper (hmictl) needs uid 0 under the car's vsomeip policy.
# Settings: /var/opt/esagono-cluster/settings.json (kept over updates, reloaded on change).
ExecStart=/usr/bin/node /var/opt/esagono-cluster/current/esagono.js
# the car's system.conf has DefaultStandardOutput=null: the log would never reach the journal
StandardOutput=journal
# the settings app's control socket: /run/esagono-cluster/ctl.sock (0666, the app runs as its own uid)
RuntimeDirectory=esagono-cluster
RuntimeDirectoryMode=0755
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

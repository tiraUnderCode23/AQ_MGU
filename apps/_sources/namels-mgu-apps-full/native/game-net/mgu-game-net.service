[Unit]
Description=GameStation phone controller firewall helper
After=oapcontroller.service
RequiresMountsFor=/var/opt
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/var/opt/mgu-game-net/current/mgu-game-net
ExecStopPost=-/usr/bin/node /var/opt/mgu-game-net/current/firewall.js close
User=root
Restart=always
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target

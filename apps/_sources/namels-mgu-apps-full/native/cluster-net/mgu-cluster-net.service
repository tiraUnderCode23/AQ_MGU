[Unit]
Description=Custom Cluster phone status link firewall helper
After=oapcontroller.service
RequiresMountsFor=/var/opt
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/var/opt/mgu-cluster-net/current/mgu-cluster-net
ExecStopPost=-/usr/bin/node /var/opt/mgu-cluster-net/current/firewall.js close
User=root
Restart=always
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target

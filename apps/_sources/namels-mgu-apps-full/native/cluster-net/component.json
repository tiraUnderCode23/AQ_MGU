{
  "id": "mgu-cluster-net",
  "kind": "tool",
  "version": "0.1.0",
  "title": "Custom Cluster Phone Port",
  "description": "Opens TCP 18977 on wlan_bridge for the Custom Cluster phone status link, only while that link is listening",
  "mguHmi": ["ID7"],
  "files": [
    {"path": "mgu-cluster-net", "mode": "0755"},
    {"path": "firewall.js", "mode": "0644"},
    {"path": "server.js", "mode": "0644"}
  ],
  "units": [{"name": "mgu-cluster-net.service", "from": "mgu-cluster-net.service"}],
  "enable": [{"unit": "mgu-cluster-net.service", "target": "multi-user.target"}],
  "recmgr": ["mgu-cluster-net"],
  "restart": ["mgu-cluster-net.service"]
}

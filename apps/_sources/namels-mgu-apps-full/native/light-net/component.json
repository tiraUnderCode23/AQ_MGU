{
  "id": "mgu-light-net",
  "kind": "tool",
  "version": "0.1.0",
  "title": "Light Show Phone Port",
  "description": "Opens TCP 18880 on wlan_bridge for the Light Show phone remote, only while Light Show listens",
  "mguHmi": ["ID7"],
  "files": [
    {"path": "mgu-light-net", "mode": "0755"},
    {"path": "firewall.js", "mode": "0644"},
    {"path": "server.js", "mode": "0644"}
  ],
  "units": [{"name": "mgu-light-net.service", "from": "mgu-light-net.service"}],
  "enable": [{"unit": "mgu-light-net.service", "target": "multi-user.target"}],
  "recmgr": ["mgu-light-net"],
  "restart": ["mgu-light-net.service"]
}

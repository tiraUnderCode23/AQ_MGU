{
  "name": "mgu-apps",
  "version": "1.0.0",
  "private": true,
  "description": "Open-source apps and companion services for BMW MGU",
  "license": "MIT",
  "scripts": {
    "build:apps": "node tools/build-prebuilt.js",
    "build:fscpatch": "node tools/build-fscpatch.js",
    "build:obd": "node tools/build-obd-adapter.js",
    "export:public": "node tools/export-public.js",
    "export:usb": "node tools/export-usb.js",
    "validate": "node tools/validate.js",
    "test": "node --test test/*.test.js && node tools/validate.js",
    "test:fsc": "go -C native/mgu-fscpatch test ./...",
    "test:obd": "go -C native/hu-obd-adapter test ./...",
    "test:generator": "python -m unittest discover -s scripts/fsc_generator/tests"
  },
  "engines": {
    "node": ">=24"
  }
}

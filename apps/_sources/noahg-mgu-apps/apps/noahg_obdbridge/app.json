{
  "id": "noahg_obdbridge",
  "title": "OBD Bridge",
  "description": "BM3 diagnostic protocol bridge over the car hotspot.",
  "version": "1.0.0",
  "vendor": "noahg",
  "loggingId": "NOBD",
  "iconGlyph": "network",
  "mguHmi": [
    "ID7"
  ],
  "requires": {
    "mgu-obd-adapter": "1.0.0"
  },
  "signals": {
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "title": "OBD Bridge",
      "kind": "canvas",
      "buttons": [
        [
          "BTN_ENABLED",
          "Enable / disable"
        ],
        [
          "BTN_PROBE",
          "Check route"
        ],
        [
          "BTN_EXPORT",
          "Save diagnostics"
        ]
      ]
    }
  ],
  "settings": []
}

    {
      "key": "rpmMap",
      "label": "Rev range",
      "type": "choice",
      "default": "locked",
      "options": [
        [
          "locked",
          "Locked to the car's engine (recommended)"
        ],
        [
          "scaled",
          "Stretched to the engine's range"
        ],
        [
          "real",
          "The car's real rpm"
        ]
      ],
      "reset": 1
    },
    {
      "key": "realRedline",
      "label": "Car's max rpm",
      "type": "number",

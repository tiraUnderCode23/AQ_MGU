{
  "id": "lfb-enginesound",
  "kind": "tool",
  "version": "1.2.2",
  "title": "Engine Sound service",
  "description": "Synthesizes the engine sound live from the car's rpm, gear and load and plays it on the car's speakers through SmartX; the sound engines Simulate and Enhance (and the legacy Waveguide, Replica); driven by the Engine Sound app",
  "license": "MIT",
  "mguHmi": [
    "ID7"
  ],
  "uninstallable": true,
  "requires": {
    "mgu-deploy": "0.7.0"
  },
  "files": [
    {
      "path": "es-synth-simulate",
      "mode": "0755"
    },
    {
      "path": "es-synth-enhance",
      "mode": "0755"
    },
    {
      "path": "es-synth-waveguide",
      "mode": "0755"
    },
    {
      "path": "es-synth-replica",
      "mode": "0755"
    },
    {
      "path": "esd.js",
      "mode": "0644"
    },
    {
      "path": "check.js",
      "mode": "0644"
    },
    {
      "path": "LICENSE",
      "mode": "0644"
    }
  ],
  "units": [
    {
      "name": "lfb-enginesound.service"
    }
  ],
  "enable": [
    {
      "unit": "lfb-enginesound.service",
      "target": "multi-user.target"
    }
  ],
  "restart": [
    "lfb-enginesound.service"
  ],
  "check": [
    "check.js"
  ]
}

{
  "id": "amn-iptv",
  "kind": "tool",
  "version": "0.3.7",
  "license": "GPL-3.0-or-later",
  "title": "IPTV service",
  "description": "For the app IPTV: the live channels, films and series of your own Xtream Codes IPTV account on the head unit. A channel's MPEG-TS stream is decoded on the GPU into mgu-render's frame file (the app shows it) and played into SmartXbar's CarLife input. Sign in once from the phone (a page on the car Wi-Fi, opened from the app's QR code); the server, user and password are kept on this head unit only (root's, 0600), never in the app or its repository. Its internet goes through mgu-uplink, as uid 13161 only; the player runs as nobody. Based on aurelmarius' TVH Player service and tvh-player (GPL-3.0-or-later).",
  "requires": {
    "mgu-deploy": "0.7.0",
    "mgu-uplink": "0.7.0"
  },
  "uninstallable": true,
  "mguHmi": ["ID7"],
  "internet": true,
  "uids": [13161],
  "files": [
    { "path": "service.js", "from": "service.js", "mode": "0644" },
    { "path": "client.js", "from": "client.js", "mode": "0644" },
    { "path": "xtream.js", "from": "xtream.js", "mode": "0644" },
    { "path": "netx.js", "from": "netx.js", "mode": "0644" },
    { "path": "page.js", "from": "page.js", "mode": "0644" },
    { "path": "nft.js", "from": "nft.js", "mode": "0644" },
    { "path": "sockgroup.js", "from": "sockgroup.js", "mode": "0644" },
    { "path": "check.js", "from": "check.js", "mode": "0644" },
    { "path": "cleanup.js", "from": "cleanup.js", "mode": "0644" },
    { "path": "cacert.pem", "from": "cacert.pem", "mode": "0644" },
    { "path": "playback.js", "from": "playback.js", "mode": "0644" },
    { "path": "film.js", "from": "film.js", "mode": "0644" },
    { "path": "langs.js", "from": "langs.js", "mode": "0644" },
    { "path": "player.js", "from": "player.js", "mode": "0644" },
    { "path": "tvh-player", "from": "tvh-player", "mode": "0755" },
    { "path": "FFMPEG-LICENSE", "from": "FFMPEG-LICENSE", "mode": "0644" },
    { "path": "README.md", "from": "README.md", "mode": "0644" }
  ],
  "check": ["check.js"],
  "deactivate": ["node", "cleanup.js"],
  "crashNames": ["tvh-player"],
  "units": [
    { "name": "amn-iptv.socket", "from": "systemd/amn-iptv.socket" },
    { "name": "amn-iptv.service", "from": "systemd/amn-iptv.service" }
  ],
  "enable": [
    { "unit": "amn-iptv.socket", "target": "sockets.target" }
  ],
  "recmgr": ["amn-iptv"],
  "restart": ["amn-iptv.service"]
}

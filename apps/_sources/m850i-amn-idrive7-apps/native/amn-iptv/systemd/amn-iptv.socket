# SPDX-License-Identifier: GPL-3.0-or-later
[Unit]
Description=amn-iptv control socket (the app IPTV)

[Socket]
# The app's connection starts amn-iptv.service; nothing of it runs before, at boot included. Root's alone
# when made; sockgroup.js then gives it the IPTV app's own group (0660), not tm_oap_app, which every app
# has. The socket file goes when the socket stops (an uninstall).
ListenStream=/run/amn-iptv.sock
SocketMode=0600
RemoveOnStop=yes
ExecStartPost=-/bin/sh -c 'ulimit -c 1; exec /usr/bin/node /var/opt/amn-iptv/current/sockgroup.js'
# no core dump from the command above to the crash handler
LimitCORE=1

[Install]
WantedBy=sockets.target

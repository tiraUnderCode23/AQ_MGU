    "readonly_reader_timeout_lifecycle": "PASS: no accumulated getters across eight poll cycles, late result discarded, recovery only after settlement, shutdown cleanup",
    "package_requires_and_mguNeeds": "PASS",
    "package_notices_and_font_closure": "PASS",

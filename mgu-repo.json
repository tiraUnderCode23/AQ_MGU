{
  "schema": 1,
  "components": [
    {
      "id": "bimmer_blocks",
      "title": "Bimmer Blocks",
      "version": "1.1.1",
      "mguHmi": [
        "ID7",
        "ID8"
      ],
      "requires": {
        "mgu-render": "0.6.24"
      },
      "mguNeeds": [
        "renderer"
      ],
      "path": "apps/_ports/appstudio-idrive8/apps/bimmer_blocks",
      "manifest": "app.json",
      "icon": "icon.png",
      "kind": "app",
      "description": "Falling-block puzzle. Play only while stationary. Manual pause, next piece, ghost and local high score.",
      "build": {
        "python": "apps/_ports/appstudio-idrive8/kit/tools/build.py",
        "args": [
          "{id}"
        ],
        "sdk": "apps/_ports/appstudio-idrive8/oap-sdk",
        "output": "apps/_ports/appstudio-idrive8/dist/{id}@{version}.tgz",
        "shared": [
          "apps/_ports/appstudio-idrive8/kit",
          "apps/_ports/appstudio-idrive8/LICENSE",
          "apps/_ports/appstudio-idrive8/THIRD-PARTY.txt",
          "apps/_ports/appstudio-idrive8/AQ_PORT.json"
        ]
      }
    },
    {
      "id": "cluster-render",
      "kind": "tool",
      "version": "0.6.9",
      "title": "Cluster renderer",
      "description": "Draws every app's layers on the instrument cluster and the HUD, sharing the display slots and one upload budget",
      "path": "tools/_released/cluster-render",
      "mguHmi": [
        "ID7",
        "ID8"
      ],
      "requires": {
        "mgu-deploy": "0.4.0"
      },
      "uninstallable": true
    },
    {
      "id": "dk_backgammon",

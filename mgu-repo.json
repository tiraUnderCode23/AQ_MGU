      "mguHmi": [
        "ID7"
      ],
      "version": "0.1.1"
    },
    {
      "id": "dk_tetris",
      "kind": "app",
      "path": "apps/_sources/mistergahan-mgu-backgammon/apps/dk_tetris",
      "build": "unit",
      "title": "Тетрис",
      "description": "Тетрис для iDrive 7: семь фигур, уровни, рекорд и сохранение.",
      "mguHmi": [
        "ID7"
      ],
      "version": "0.1.1"
    },
    {
      "id": "doom",
      "kind": "app",
      "version": "1.7.22",
      "title": "Doom",
      "description": "Doom (Freedoom: Phase 1) on the iDrive. Main menu with all settings; the game drawn in full resolution across the whole screen, on the controller; BACK returns to the menu and saves",
      "path": "apps/_sources/idrive7-apps/apps/doom",
      "manifest": "app.json",
      "mguHmi": [
        "ID7",
        "ID8"
      ],
      "requires": {
        "idrive7-renderd": "2.1.18",
        "mgu-inputgate": "1.1.0"
      },
      "build": {
        "python": "apps/_sources/idrive7-apps/kit/tools/build.py",
        "args": [
          "{id}"
        ],
        "sdk": "apps/_sources/idrive7-apps/oap-sdk",
        "output": "apps/_sources/idrive7-apps/dist/{id}@{version}.tgz",
        "shared": [
          "apps/_sources/idrive7-apps/kit"
        ]
      },
      "icon": "icon.png"
    },
    {
      "id": "iabadia_m_arcade",
      "kind": "app",
      "title": "M Arcade",
      "description": "Six games in one controller-first arcade, with shared menus, progress and named records",
      "version": "0.1.3",
      "requires": {
        "mgu-render": "0.6.9"
      },
      "mguHmi": [
        "ID7"
      ],
      "uninstallable": true,
      "path": "apps/_sources/iabadia-idrive-games/apps/iabadia_m_arcade",
      "build": "unit"
    },
    {
      "id": "idrive7-renderd",
      "kind": "tool",
      "version": "2.1.19",
      "title": "GPU renderer",
      "description": "The apps' own GPU renderer (mgu-render): draws them at 60 fps, beside the MGU Store's Renderer; installed with the apps (iDrive 7 and iDrive 8)",
      "requires": {
        "mgu-deploy": "0.6.1"
      },
      "optional": true,
      "uninstallable": true,
      "mguHmi": [
        "ID7",
        "ID8"
      ],
      "path": "apps/_sources/idrive7-apps/kit/renderd/prebuilt",
      "provides": "renderer"
    },
    {
      "id": "mgu-game-net",
      "kind": "tool",
      "version": "0.1.0",
      "title": "GameStation Phone Port",
      "description": "Opens TCP 18878 on wlan_bridge for the GameStation phone controllers, only while GameStation listens",
      "path": "apps/_sources/namels-mgu-apps-full/native/game-net",
      "mguHmi": [
        "ID7"
      ],
      "requires": {}
    },
    {
      "id": "mgu-inputgate",
      "kind": "tool",
      "title": "Controller gate",
      "description": "Lets the apps have the iDrive controller (tabs, page buttons, settings, Doom); loads into the HMI at the next start (iDrive 7 and iDrive 8)",
      "mguHmi": [
        "ID7",
        "ID8"
      ],
      "version": "1.2.2",
      "path": "tools/_packages/mgu-inputgate",
      "requires": {
        "mgu-deploy": "0.3.2"
      }
    },
    {
      "id": "mgu_gamestation",
      "kind": "app",
      "version": "0.3.0",
      "title": "MGU GameStation",
      "description": "Offline retro games with iDrive or phone controllers, two players and in-game saves. Parked only.",
      "path": "apps/_sources/namels-mgu-apps-full/apps/mgu_gamestation",
      "manifest": "app.json",
      "mguHmi": [
        "ID7"
      ],
      "requires": {
        "idrive7-renderd": "2.1.6",
        "mgu-inputgate": "1.0.0",
        "mgu-game-net": "0.1.0"
      },
      "build": {
        "python": "apps/_sources/namels-mgu-apps-full/tools/build_store_app.py",
        "args": [
          "{id}"
        ],
        "sdk": "apps/_sources/namels-mgu-apps-full/oap-sdk",
        "output": "apps/_sources/namels-mgu-apps-full/dist/{id}@{version}.tgz",
        "shared": [
          "apps/_sources/namels-mgu-apps-full/kit",
          "apps/_sources/namels-mgu-apps-full/tools"
        ]
      },
      "icon": "icon.png"
    },
    {
      "id": "mx_road_hopper",
      "kind": "app",
      "version": "0.1.1",
      "title": "Road Hopper",

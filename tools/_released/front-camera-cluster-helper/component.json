      "from": "files/front-camera-cluster.conf"
    },
    {
      "path": "sources.json",
      "mode": "0644",
      "sha256": "530ef1ba0267ac6e62d06fdb78c70e89d528d53d8505d550ff627f62882f2477",
      "from": "files/sources.json"
    }
  ],
  "units": [
    {
      "name": "front-camera-cluster.service",
